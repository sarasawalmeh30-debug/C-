@{
}
@model Employee

<h2>Add Employee</h2>

<form asp-action="Create" method="post">
    <div>
        <label>Full Name :</label>
        <input type="text" name="FullName"  value="@Model.FullName"/>
    </div>

    <div>
        <label>Phone</label>
        <input name="Phone"  value="@Model.Phone"/>

    </div>
    <div>
        <label>Email</label>
        <input  name="Email"  value="@Model.Email"/>

    </div>
     <div>
        <label>Position</label>
        <input  name="Position"  value="@Model.Position"/>

    </div>
     <div>
        <label>Salary</label>
        <input  name="Salary"  value="@Model.Salary"/>

    </div>
     <div>
        <label>Hire Date</label>
        <input  name="HireDate"  value="@Model.HireDate"/>

    </div>
    <button type="submit">Save</button>
</form>