    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model List<Product_model>

<h2>Products</h2>

<a asp-action="Create">Add Product</a>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Supplier</th>
            <th>Category</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var Products in Model)
        {
            <tr>
                <td>@Products.Id</td>
                <td>@Products.Name</td>
                <td>@Products.Price</td>
                <td>@Products.Quantity</td>
                <th>@Products.Supplier_modelId</th>
                <th>@Products.Category_modelId</th>
                 <td class="actions">
                    <a asp-action="Edit" asp-route-id="@Products.Id">Edit</a>
                    <a asp-action="Details" asp-route-id="@Products.Id">Details</a>
                    <form asp-action="Delete" asp-route-id="@Products.Id" method="post"
                          onsubmit="return confirm('Are you sure you want to delete this user?');">
                        <button class="delete" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
