@{
}
@model List<Product_model>

<h2>Products</h2>

<a asp-action="Create">Add Product</a>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Supplier</th>
            <th>Category</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var Products in Model)
        {
            <tr>
                <td>@Products.Id</td>
                <td>@Products.Name</td>
                <td>@Products.Price</td>
                <td>@Products.Quantity</td>
                <th>@Products.Supplier_modelId</th>
                <th>@Products.Category_modelId</th>
            </tr>
        }
    </tbody>
</table>
