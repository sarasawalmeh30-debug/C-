@{
}
@model List<Category_model>

<h2>Category</h2>

<a asp-action="Create">Add Category</a>

<table>
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td class="actions">
                    <a asp-action="Edit" asp-route-id="@category.Id">Edit</a>
                    <a asp-action="Details" asp-route-id="@category.Id">Details</a>
                    <form asp-action="Delete" asp-route-id="@category.Id" method="post"
                          onsubmit="return confirm('Are you sure you want to delete this user?');">
                        <button class="delete" type="submit">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
