@model IEnumerable<tasksara.Models.Manager>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NameManager)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmailManager)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PasswordManager)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Employees)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.NameManager)
            </td>
            <td>
                @Html.DisplayFor(model => item.EmailManager)
            </td>
            <td>
                @Html.DisplayFor(model => item.PasswordManager)
            </td>
            <td>
                @Html.DisplayFor(model => item.Employees)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ManagerId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ManagerId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ManagerId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
