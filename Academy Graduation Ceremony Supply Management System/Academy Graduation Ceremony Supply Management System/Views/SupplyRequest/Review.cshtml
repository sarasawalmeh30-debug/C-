@{
}
<h2>Review Request</h2>

<p>@ViewBag.CertificateCategory — @ViewBag.CertificateSupplier — @ViewBag.CertificateOfferName</p>
<p>@ViewBag.HospitalityCategory — @ViewBag.HospitalitySupplier — @ViewBag.HospitalityOfferName</p>
<p>@ViewBag.GiftCategory — @ViewBag.GiftSupplier — @ViewBag.GiftOfferName</p>
<table class="table">
    <thead>
        <tr>
            <th>Category</th>
            <th>Selected Offer Total</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>Graduation Certificates</td>
            <td>@ViewBag.CertificateTotal JD</td>
        </tr>
        <tr>
            <td>Hospitality</td>
            <td>@ViewBag.HospitalityTotal JD</td>
        </tr>
        <tr>
            <td>Graduation Gifts</td>
            <td>@ViewBag.GiftTotal JD</td>
        </tr>
    </tbody>
</table>

<p>Total Price: @ViewBag.Total JD</p>
<p>Discount: @(ViewBag.Discount * 100)%</p>
<p>Discount Amount: @ViewBag.DiscountAmount JD</p>
<p>Final Total: @ViewBag.FinalTotal JD</p>