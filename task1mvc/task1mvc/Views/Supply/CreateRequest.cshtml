@{
}
<!DOCTYPE html>
<html>
<head>
    <title>Create Request</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">

    <div class="container mt-5">

        <div class="card shadow p-4">

            <h2 class="text-center mb-4">Product Request Form</h2>

            @if (ViewBag.Message != null)
            {
                <div class="alert @ViewBag.MessageClass">
                    @ViewBag.Message
                </div>
            }

            <form asp-controller="Supply" asp-action="SubmitRequest" method="post">

                <div class="mb-3">
                    <label class="form-label">Employee Name</label>
                    <input type="text" name="EmployeeName" class="form-control">
                </div>

                <div class="mb-3">
                    <label class="form-label">Product Name</label>
                    <select name="ProductName" class="form-select">
                        <option value="Water">Water</option>
                        <option value="Orange Juice">Orange Juice</option>
                        <option value="Coffee">Coffee</option>
                        <option value="Sandwich">Sandwich</option>
                        <option value="Chocolate">Chocolate</option>

                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Quantity</label>
                    <input type="number" name="Quantity" class="form-control" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Required Date</label>
                    <input type="date" name="RequiredDate" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-primary">  Submit Request  </button>
            </form>
        </div>
    </div>
</body>
</html>
