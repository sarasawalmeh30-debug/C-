*@
@{

    string[] product = { "Water", "Orange Juice", "Coffee", "Sandwich", "Chocolate" };
}
@section Scripts{
    <script>
        alert("Welcome to the Products Page!")
    </script>
}
@section style{
   <link href="~/css/products.css" rel="stylesheet" />
}
<h2>Our Products:</h2>
<ul>
    @foreach (string i in product)
    {
        <li>@i</li>
    }
</ul>


@if (product.Length > 0)
{
    <p>We have products.</p>
}
else
{
    <p>We don't have products.</p>
}

@if (product.Length >= 3)
{
    <p>We have enough Products.</p>
}
else
{
    <p>We need more Products.</p>
}