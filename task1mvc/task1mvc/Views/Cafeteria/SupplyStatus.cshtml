@{
    Layout = null;
}
<style>
    .status-available {
        background-color: green;
        color: white;
    }

    .status-low {
        background-color: yellow;
        color: black;
    }

    .status-out {
        background-color: red;
        color: white;
    }
</style>
@{
    string[] products = { "Water", "Orange Juice", "Coffee", "Sandwich", "Chocolate" };

    string[] suppliers = {
        "Fresh Food Company",
        "Happy Drinks Company",
        "Daily Supplies Company",
        "Fresh Food Company",
        "Daily Supplies Company"
    };

    int[] quantities = { 100, 20, 50, 0, 30 };

    string[] statuses = {
        "Available",
        "Low Stock",
        "Available",
        "Out of Stock",
        "Available"
    };
}

<table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Number</th>
                    <th>Product Name</th>
                    <th>Supplier</th>
                    <th>Quantity</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>

                @for (int i = 0; i < products.Length; i++)
                {
                    <tr>
                        <td>@(i + 1)</td>

                        <td>@products[i]</td>

                        <td>@suppliers[i]</td>

                        <td>@quantities[i]</td>
                        <td>
                   @if (statuses[i] == "Available")
                   {
                       <span class="badge status-available">@statuses[i] </span>
                   }
                   else if (statuses[i] == "Low Stock")
                   {
                       <span class="badge status-low"> @statuses[i]</span>
                   }
                   else
                   {
                       <span class="badge status-out"> @statuses[i]</span>
                   }
                        </td>

                    </tr>
                }
             </tbody>
  </table>