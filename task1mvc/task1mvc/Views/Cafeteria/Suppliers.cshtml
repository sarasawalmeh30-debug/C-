@{
    Layout = "_SimpleLayout";
}
@{
    string[] arr = { "Fresh Food Company", "Happy Drinks Company", "Daily Supplies Company" };
   
}
@foreach(var i in arr)
{
    <p>@i</p>
}
@if (arr.Length >= 3)
{
    <p>We have enough suppliers.</p>
}
else
{
    <p>We need more suppliers.</p>
}