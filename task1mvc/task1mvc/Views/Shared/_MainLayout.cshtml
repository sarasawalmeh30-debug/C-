<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"  rel="stylesheet">
    @RenderSection("style",required:false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

        <div class="container">
            <a class="navbar-brand"href="@Url.Action("Index", "Cafeteria")">  University Cafeteria  </a>
            <div class="navbar-nav">
                <a class="nav-link"href="@Url.Action("Index", "Cafeteria")">  Home </a>
                <a class="nav-link" href="@Url.Action("Products", "Cafeteria")">  Products </a>
                <a class="nav-link"  href="@Url.Action("Suppliers", "Cafeteria")"> Suppliers </a>
