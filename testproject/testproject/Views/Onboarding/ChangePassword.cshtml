@model testproject.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Change your password"; }
<div class="row justify-content-center"><div class="col-lg-6">
<p class="eyebrow">FIRST SIGN IN · SECURITY</p>
<h1 class="h3">Set a new password</h1>
<p class="page-lead">Your admin gave you a temporary password. Replace it to continue to your onboarding screen.</p>
<form asp-action="ChangePassword" method="post" class="onboarding-card form-stack">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div><label asp-for="CurrentPassword" class="form-label">Current password</label><input asp-for="CurrentPassword" class="form-control"/><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
    <div><label asp-for="NewPassword" class="form-label">New password</label><input asp-for="NewPassword" class="form-control"/><span asp-validation-for="NewPassword" class="text-danger"></span></div>
    <div><label asp-for="ConfirmPassword" class="form-label">Confirm new password</label><input asp-for="ConfirmPassword" class="form-control"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Save password</button>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
