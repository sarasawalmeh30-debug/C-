@model testproject.Models.SupplierProfileViewModel
@{ ViewData["Title"] = "Complete your company profile"; }
<div class="row justify-content-center"><div class="col-lg-8">
<p class="eyebrow">FIRST SIGN IN · STEP 1 OF 4 · SUPPLIER</p>
<h1 class="h3 mb-2">Welcome, @ViewBag.RoleLabel</h1>
<p class="page-lead">Add the company and contact details missing from registration. Required fields are marked below.</p>
<form asp-action="Supplier" method="post" class="onboarding-card form-stack">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div><label asp-for="FullName" class="form-label">Your full name</label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger"></span></div>
    <div><label asp-for="CompanyName" class="form-label">Company name</label><input asp-for="CompanyName" class="form-control"/><span asp-validation-for="CompanyName" class="text-danger"></span></div>
    <div class="row"><div class="col-md-6"><label asp-for="TaxNumber" class="form-label">Tax number</label><input asp-for="TaxNumber" class="form-control"/><span asp-validation-for="TaxNumber" class="text-danger"></span></div><div class="col-md-6"><label asp-for="CommercialRegNumber" class="form-label">Commercial registration number</label><input asp-for="CommercialRegNumber" class="form-control"/><span asp-validation-for="CommercialRegNumber" class="text-danger"></span></div></div>
    <div><label asp-for="Category" class="form-label">Product or service category</label><input asp-for="Category" class="form-control" placeholder="For example: packaging or raw materials"/><span asp-validation-for="Category" class="text-danger"></span></div>
    <div class="row"><div class="col-md-6"><label asp-for="Country" class="form-label">Country</label><input asp-for="Country" class="form-control"/><span asp-validation-for="Country" class="text-danger"></span></div><div class="col-md-6"><label asp-for="City" class="form-label">City</label><input asp-for="City" class="form-control"/><span asp-validation-for="City" class="text-danger"></span></div></div>
    <div><label asp-for="Address" class="form-label">Company address</label><input asp-for="Address" class="form-control"/><span asp-validation-for="Address" class="text-danger"></span></div>
    <div class="row"><div class="col-md-6"><label asp-for="ContactPerson" class="form-label">Contact person</label><input asp-for="ContactPerson" class="form-control"/><span asp-validation-for="ContactPerson" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ContactPhone" class="form-label">Contact phone</label><input asp-for="ContactPhone" class="form-control"/><span asp-validation-for="ContactPhone" class="text-danger"></span></div></div>
    <div><label asp-for="Website" class="form-label">Website (optional)</label><input asp-for="Website" class="form-control" placeholder="https://example.com"/><span asp-validation-for="Website" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Save and continue</button>
</form></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
